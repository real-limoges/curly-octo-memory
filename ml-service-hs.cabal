cabal-version: 3.0

name: ml-service-hs
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/githubuser/ml-service-hs#readme>ue
author: Real Limoges
copyright: 2025 Author name here
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-source-files:
  README.md

source-repository head
  type: git
  location: https://github.com/real-limoges/ml-service-hs

library
  exposed-modules:
    API
    Core
    Lib
    Server
    Types
  other-modules:
    Paths_ml_service_hs
  autogen-modules:
    Paths_ml_service_hs
  hs-source-dirs:
    src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
    base >=4.7 && <5,
    aeson,
    bytestring,
    text,
    vector,
    hedis,
    postgresql-simple,
    servant,
    servant-server,
    wai,
    warp

  default-language: Haskell2010

executable ml-service-hs-exe
  main-is: Main.hs
  other-modules:
    Paths_ml_service_hs
  autogen-modules:
    Paths_ml_service_hs
  hs-source-dirs:
    app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base >=4.7 && <5,
    ml-service-hs,
    warp,
    wai
  default-language: Haskell2010

test-suite ml-service-hs-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
    Paths_ml_service_hs
  autogen-modules:
    Paths_ml_service_hs
  hs-source-dirs:
    test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    aeson,
    base >=4.7 && <5,
    bytestring,
    ml-service-hs,
    servant,
    text,
    vector
  default-language: Haskell2010
